{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowEvsientAppDistributionOnly",
      "Effect": "Allow",
      "Principal": { "Service": "cloudfront.amazonaws.com" },
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::future-city-app/*",
      "Condition": {
        "StringEquals": {
          "AWS:SourceArn": "arn:aws:cloudfront::ACCOUNT_ID:distribution/E1JXKS26TDP3Z2"
        }
      }
    },
    {
      "Sid": "DenyNonTLS",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": ["arn:aws:s3:::future-city-app", "arn:aws:s3:::future-city-app/*"],
      "Condition": { "Bool": { "aws:SecureTransport": "false" } }
    }
  ]
}
