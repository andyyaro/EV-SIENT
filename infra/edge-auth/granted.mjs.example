// Copy to `granted.mjs` (same folder, NOT tracked) and replace the placeholder below.
//
// One entry per person allowed into /platform. `sub` is the user's Cognito id, read with
//   aws cognito-idp admin-get-user --user-pool-id us-east-1_mKrwfQTkg --username <email> \
//     --profile future-city --query "UserAttributes[?Name=='sub'].Value" --output text
// and `email` is their sign-in email in lower case. A token must match BOTH fields of the SAME
// entry (index.mjs, isGranted), so a mix of two people's claims is refused.
//
// Being able to sign in to the pool is not the same as being on this list: the pool is shared,
// and a pool member who is not listed here is refused.
export const GRANTED = [
  { sub: "00000000-0000-4000-8000-000000000000", email: "person@example.org" },
];
